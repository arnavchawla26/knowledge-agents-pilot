# Copy to .env (gitignored). Never commit .env.
NVIDIA_API_KEY=your-nvidia-key-here
ANTHROPIC_API_KEY=your-anthropic-key-here
# kap's own Postgres (docker-compose.yml service sourcedb, host port 5434)
KAP_PG_USER=sois
KAP_PG_PASSWORD=kap_local_dev_only
KAP_PG_DB=sois
KAP_PG_HOST=localhost
KAP_PG_PORT=5434
# read-only role the MCP server and agents use (created by `make load`)
KAP_PG_RO_USER=kap_ro
KAP_PG_RO_PASSWORD=kap_ro_local_dev_only
# Project 1 checkout (read-only input: CSVs, parquet, reports, truth)
SOIS_DIR=../services-ops-intelligence
# Elasticsearch
KAP_ES_URL=http://localhost:9201
# Auto Ontology (vendor/auto-ontology compose)
AO_API_URL=http://localhost:3000
AO_API_TOKEN=
